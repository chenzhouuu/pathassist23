# Local environment overrides (not committed to source control by default)
# Set the branding logo to the public image in public/mda-logo.png
VITE_LOGO_SRC=/mda-logo.png
VITE_APP_NAME=Pathassist

# ── AskPA LLM Keys ────────────────────────────────────────────────────────────
# Claude (Anthropic) — enables Sonnet + Opus buttons
# VITE_ANTHROPIC_API_KEY=sk-ant-...

# MedGemma (Google AI Studio) — enables MedGemma button
# VITE_GEMINI_API_KEY=AIza...

# ── AskPA Local Models (DCPenn) ───────────────────────────────────────────────
# URL of the Gemma FastAPI server on DCPenn (default: DCPenn LAN IP)
VITE_DCPENN_LLM_URL=http://192.168.191.109:11500

# Which models to show in the AskPA selector — comma-separated model IDs.
# Available IDs: claude-sonnet-4-6, claude-opus-4-6, medgemma-4b-it, gemma4
# Comment out to show ALL models (default)
# VITE_ENABLED_CHAT_MODELS=claude-sonnet-4-6,gemma4
