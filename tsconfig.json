{
  // TypeScript arrived with the OHIF ui-next components, which are authored in .tsx. The rest of
  // the app is .jsx and stays that way, so `allowJs` is on and `checkJs` is off: TS type-checks
  // what is written in TS and leaves the JavaScript alone. `noEmit` because Vite does the
  // transpiling — tsc is only ever run as a checker (`npm run typecheck`).
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    "allowJs": true,
    "checkJs": false,

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["node_modules", "dist"]
}
