# Production environment — used by `npm run build`
# Copy this file to the project root as .env.production before deploying.

# Girder API base URL (direct — no proxy in production)
# API goes through CloudFront → /api/* behavior → Girder EC2 (no CORS needed)
VITE_GIRDER_BASE=https://apps.pathassist.health/api/v1

# App URL (for OAuth redirects)
VITE_APP_URL=https://apps.pathassist.health

# Optional: set your app name / branding
# VITE_APP_NAME=PathAssist
