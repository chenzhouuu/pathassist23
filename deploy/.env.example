# =============================================================================
# deploy/.env.example
# Copy this to /opt/digital_slide_archive/devops/ver5/.env on EC2
# and fill in real values. NEVER commit .env to git.
# =============================================================================

# ── System ────────────────────────────────────────────────────────────────────
# Get your user:group id with: id -u && id -g
DSA_USER=1000:1000

# ── Keycloak ──────────────────────────────────────────────────────────────────
# Keycloak admin console login
KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=CHANGE_ME_strong_password_here

# PostgreSQL password for Keycloak's database
KC_DB_PASSWORD=CHANGE_ME_db_password_here

# ── RabbitMQ (optional, defaults to guest/guest) ──────────────────────────────
# RABBITMQ_DEFAULT_USER=pathassist
# RABBITMQ_DEFAULT_PASS=CHANGE_ME

# ── DSA ───────────────────────────────────────────────────────────────────────
# DSA_PORT=8080   # uncomment to change Girder's exposed port

# ── AskPA LLM configuration ───────────────────────────────────────────────────
# Claude (Anthropic) — enables Sonnet + Opus buttons in AskPA
# VITE_ANTHROPIC_API_KEY=sk-ant-...

# MedGemma (Google AI Studio) — enables MedGemma button
# VITE_GEMINI_API_KEY=AIza...

# DCPenn local Gemma server — enables Gemma4 27B button (free, private)
# VITE_DCPENN_LLM_URL=http://192.168.191.109:11500

# Restrict which models appear in AskPA selector (comma-separated IDs).
# Available: claude-sonnet-4-6, claude-opus-4-6, medgemma-4b-it, gemma4
# Leave unset to show all models.
# VITE_ENABLED_CHAT_MODELS=claude-sonnet-4-6,gemma4
