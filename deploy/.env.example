# =============================================================================
# deploy/.env.example
# Copy this to /opt/digital_slide_archive/devops/ver5/.env on EC2
# and fill in real values. NEVER commit .env to git.
# =============================================================================

# ── System ────────────────────────────────────────────────────────────────────
# Get your user:group id with: id -u && id -g
DSA_USER=1000:1000

# ── Keycloak ──────────────────────────────────────────────────────────────────
# Keycloak admin console login
KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=CHANGE_ME_strong_password_here

# PostgreSQL password for Keycloak's database
KC_DB_PASSWORD=CHANGE_ME_db_password_here

# ── RabbitMQ (optional, defaults to guest/guest) ──────────────────────────────
# RABBITMQ_DEFAULT_USER=pathassist
# RABBITMQ_DEFAULT_PASS=CHANGE_ME

# ── DSA ───────────────────────────────────────────────────────────────────────
# DSA_PORT=8080   # uncomment to change Girder's exposed port

# ── Ki67 analysis (browser-side VLM calls) ────────────────────────────────────
# These are read by the annotation context menu's Ki67 analysis and the whole-slide
# ROI grid. They are inlined into the bundle by Vite — anyone who can load the page
# can read them, so scope them to the minimum and rotate on exposure.
#
# Claude (Anthropic) — Ki67 on a single ROI
# VITE_ANTHROPIC_API_KEY=sk-ant-...

# Gemini (Google AI Studio) — Ki67 on a single ROI and the whole-slide grid
# VITE_GEMINI_API_KEY=AIza...

# The DCPenn LLM/BRCA URLs and the chat-model allowlist went with AskPA on 2026-08-03;
# nothing reads them any more. See docs/askpa-technical-report.md.
