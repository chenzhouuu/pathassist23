# =============================================================================
# deploy/.env.example
# Copy this to /opt/digital_slide_archive/devops/ver5/.env on EC2
# and fill in real values. NEVER commit .env to git.
# =============================================================================

# ── System ────────────────────────────────────────────────────────────────────
# Get your user:group id with: id -u && id -g
DSA_USER=1000:1000

# ── Keycloak ──────────────────────────────────────────────────────────────────
# Keycloak admin console login
KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=CHANGE_ME_strong_password_here

# PostgreSQL password for Keycloak's database
KC_DB_PASSWORD=CHANGE_ME_db_password_here

# ── RabbitMQ (optional, defaults to guest/guest) ──────────────────────────────
# RABBITMQ_DEFAULT_USER=pathassist
# RABBITMQ_DEFAULT_PASS=CHANGE_ME

# ── DSA ───────────────────────────────────────────────────────────────────────
# DSA_PORT=8080   # uncomment to change Girder's exposed port

# ── Model API keys — none any more ────────────────────────────────────────────
# The frontend no longer talks to a model vendor. VITE_ANTHROPIC_API_KEY and
# VITE_GEMINI_API_KEY went with the AI tab on 2026-08-03, along with the DCPenn LLM/BRCA
# URLs and the chat-model allowlist that went with AskPA the same day. Nothing reads any
# of them; delete them from any .env you are carrying forward.
#
# The reason is worth keeping: a VITE_* key is inlined into the bundle, so shipping one
# publishes it to everyone who can load the page. Model calls belong on the server, where
# the agent gateway and the analysis services already hold their own credentials.
# See docs/ai-panel-technical-report.md and docs/askpa-technical-report.md.
